# Ballast Risk Desk: publisher, keeper, guardian, x402 data and the read API in one process.
# Install: see deploy/README.md. Secrets live only in /etc/ballast/agent.env (root:root, 0600; systemd reads
# it as root). The code under /opt/ballast is root-owned and read-only to the service user.
[Unit]
Description=Ballast Risk Desk
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=ballast
Group=ballast
WorkingDirectory=/opt/ballast/apps/agent
EnvironmentFile=/etc/ballast/agent.env
ExecStart=/opt/ballast/apps/agent/node_modules/.bin/tsx src/desk/main.ts
Restart=always
RestartSec=10
# SIGTERM stops the loops, lets a send waiting for its receipt finish, then flushes the ledger and state.
KillSignal=SIGTERM
TimeoutStopSec=180
# Desk state (feed, ledger, guardian cursor, evidence) lives in the state directory /var/lib/ballast, which
# systemd creates for the service user. agent.env sets DATA_DIR to it; the default below covers an env file
# that leaves it out. The desk test-writes DATA_DIR at startup and exits non-zero if it cannot.
StateDirectory=ballast
Environment=DATA_DIR=/var/lib/ballast
StateDirectoryMode=0750
UMask=0027

# Hardening: the desk needs the network and its state directory, nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
LimitNOFILE=8192
MemoryMax=1G

[Install]
WantedBy=multi-user.target
