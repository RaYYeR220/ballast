# /etc/ballast/agent.env: environment of the Ballast Risk Desk (deploy/ballast-agent.service).
# Copy to /etc/ballast/agent.env, chown root:ballast, chmod 0640, then fill in. Never commit the filled file.
# Empty means "not set": the desk then uses the default named in the comment.

# --- chain ---------------------------------------------------------------------------------------------
# 56 for BSC mainnet (97 BSC testnet, 31337 a local anvil fork). Required.
CHAIN_ID=
# RPC endpoint, http(s). Treated as a secret (providers put keys in the path); never logged. Required.
BSC_RPC_URL=
# Deployment addresses. Default: contracts/deployments/<CHAIN_ID>.json in the checkout.
DEPLOYMENT_FILE=

# --- signer: the publisher / keeper / guardian provider key ----------------------------------------------
# Either a raw key (0x + 64 hex) ...
AGENT_PRIVATE_KEY=
# ... or a Web3 Secret Storage v3 keystore (Agent Studio writes this format) and its password. Not both.
# Keep the keystore outside /home (the service runs with ProtectHome), e.g. /etc/ballast/desk.keystore.
AGENT_KEYSTORE_PATH=
AGENT_KEYSTORE_PASSWORD=
# Accepted instead of AGENT_KEYSTORE_PASSWORD (the name Studio uses in .studio/.env.local).
WALLET_PASSWORD=
# Alert in the feed when the key holds less BNB than this. Default 0.003.
MIN_BNB_BALANCE=

# --- Binance Web3 API (optional) -------------------------------------------------------------------------
# Both or neither. Unset: keyless public endpoints only, eth_call simulation, plain RPC broadcast.
# Keyed calls must egress from an allowed country (run the VPS in DE or FR); 40304 means geo-blocked.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
# Append a JSON line per Binance call (latency, status, code) for the DX log; "off" disables it.
# Default .dx-probe.jsonl in the working directory, which is read-only under the unit: use the state dir.
DX_PROBE_FILE=

# --- state and inputs ------------------------------------------------------------------------------------
# Feed, ledger, guardian cursor, evidence files, purchased earnings, notes. Use /var/lib/ballast (the
# unit's StateDirectory). Default apps/agent/var/ in the checkout.
DATA_DIR=
# Operator earnings schedule, the fallback for paid dates. Default config/earnings.json in the checkout.
EARNINGS_FILE=

# --- read API --------------------------------------------------------------------------------------------
# Bind address and port of the desk read API. Keep loopback: Caddy terminates HTTPS in front of it.
# Defaults 127.0.0.1 and 8787.
HTTP_HOST=
HTTP_PORT=
# The web app origin allowed by CORS, e.g. https://app.example.org (no path). Unset: no CORS headers.
WEB_ORIGIN=
# Requests per minute per client IP. Default 120.
API_RATE_PER_MIN=

# --- Agent Studio faces (A2A / MCP) ----------------------------------------------------------------------
# Only read by the Studio entrypoints, which this unit does not start. Must be loopback on chain 56.
# Defaults 127.0.0.1 and 9000.
AGENT_BIND_HOST=
AGENT_PORT=

# --- x402 paid data --------------------------------------------------------------------------------------
# Earnings-calendar endpoint paid per call over x402. Unset: off (the operator file alone is used).
# {symbol}, {from}, {to} are filled in; without them ticker/from/to query parameters are appended.
X402_EARNINGS_URL=
# Most one call may cost, USD; at most 0.05. Default 0.05.
X402_MAX_PRICE_USD=
# Networks the desk pays on, in order of preference (CAIP-2). Default eip155:56,eip155:8453.
X402_NETWORKS=
# Ceiling on all x402 spend per UTC day, USD. Default 0.5.
X402_DAILY_CAP_USD=

# --- desk notes (LLM) ------------------------------------------------------------------------------------
# "auto" writes a two-sentence note after each shield, restore or refusal with the Studio [llm] provider
# when its key is present; "off" never calls it. Notes never drive a decision. Default auto.
DESK_NOTES=
# studio.toml whose [llm] section is used. Default apps/agent/app/agent/studio.toml.
STUDIO_TOML=
# Key of the provider named in studio.toml (only the one that applies). Secrets: scrubbed from all output.
PIEVERSE_LLM_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER_API_KEY=
LLM_PROVIDER_B_API_KEY=

# --- safety switches -------------------------------------------------------------------------------------
# true: simulate every write and broadcast nothing (x402 is not paid either). Default true.
DRY_RUN=
# Local fork only (CHAIN_ID 31337): run every loop at this interval, seconds. Refused on any other chain.
FORK_TICK_SEC=

# --- ERC-8004 registration script only (pnpm run register) -----------------------------------------------
AGENT_PUBLIC_URL=
APP_URL=
