# Ballast MCP server (deploy/ballast-mcp.service). Copy to /etc/ballast/mcp.env.
# No key belongs here: the server only reads the chain and plans. Keep the file root:root 0600 anyway if the
# RPC URL carries an API key.

# BSC RPC the tools read from.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
CHAIN_ID=56
DEPLOYMENT_FILE=/opt/ballast/contracts/deployments/56.json

# The public host name Caddy serves, exactly as clients send it in the Host header (no scheme, no path; add
# :port only when the public port is not 443). Comma-separated for several. Requests for any other host are
# refused, and so are browser requests from an origin other than https://<this host>.
MCP_ALLOWED_HOSTS=desk.example.org
# Optional: further browser origins to accept, comma-separated (https://app.example.org).
MCP_ALLOWED_ORIGINS=
# Requests a minute per client address (the address Caddy reports; 0 turns the limit off). Default 120.
MCP_RATE_PER_MIN=120
