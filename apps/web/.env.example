# Every variable is optional. Unset, each has the default or the explicit page state named below.
# A malformed value stops the server at startup with one line per problem (the value itself is never printed).

# Chain the app talks to: 56 (BNB Chain) or 31337 (a local anvil fork of it). Default 56.
NEXT_PUBLIC_CHAIN_ID=56

# Server-side RPC for chain reads and eth_call simulation. May carry a provider key: it never reaches the browser.
# Must be an http(s) URL that accepts batched requests. Defaults: https://bsc-rpc.publicnode.com for 56,
# http://127.0.0.1:8545 for 31337. Use a dedicated endpoint in production.
BSC_RPC_URL=

# Ballast deployment. Default: contracts/deployments/<chainId>.json from this repository (BNB Chain mainnet is
# in the repository). DEPLOYMENT_JSON is the file's contents inline; DEPLOYMENT_FILE is a path relative to the
# repository root. Set at most one. A named deployment must exist, be valid, and be for NEXT_PUBLIC_CHAIN_ID.
# With no deployment at all the app says "contracts not deployed yet".
DEPLOYMENT_JSON=
DEPLOYMENT_FILE=

# Desk agent read API (apps/agent), an http(s) URL. The site reads its /health, /feed, /oracle, /ledger and
# /evidence through /api/desk; the browser never talks to the desk. Unset or unreachable: the desk is shown as
# offline. The public desk for BNB Chain mainnet:
AGENT_API_URL=https://34-185-146-173.sslip.io

# Address of the desk agent, named as keeper for new accounts and covers. Default on chain 56: the mainnet desk
# agent 0xccD7f069275549793b2A8804A5691fCa6665D152 (ERC-8004 agent 368122). On a fork there is no default: set it,
# or the desk's /health supplies it.
DESK_AGENT_ADDRESS=

# Binance Web3 API, server-side only; set both or neither. With them, on BNB Chain: /api/simulate previews with
# the Binance Transaction API (eth_call otherwise), the wallet's tokenized stocks come from the Wallet API and
# its lending positions from the DeFi API. Each falls back to an explicit "Binance API unavailable" state.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# RPC the wallet uses for the local fork chain (31337 only).
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545

# Public site URL, for metadata.
NEXT_PUBLIC_SITE_URL=https://ballast-desk.vercel.app
