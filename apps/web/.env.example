# Chain the app talks to: 56 (BNB Chain) or 31337 (a local anvil fork of it).
NEXT_PUBLIC_CHAIN_ID=56

# Server-side RPC for chain reads and eth_call simulation. May carry a provider key: it never reaches the browser.
# Defaults: https://bsc-dataseed.bnbchain.org for 56, http://127.0.0.1:8545 for 31337.
BSC_RPC_URL=

# Ballast deployment. By default contracts/deployments/<chainId>.json from this repository.
# DEPLOYMENT_FILE is a path relative to the repository root; DEPLOYMENT_JSON is the file's contents inline.
# Without a deployment the app says "contracts not deployed yet".
DEPLOYMENT_FILE=
DEPLOYMENT_JSON=

# Desk agent read API (apps/agent). Unset or unreachable: the app shows the desk as offline.
AGENT_API_URL=

# Address of the desk agent, named as keeper for new accounts and covers. When unset, the desk's /health supplies it.
DESK_AGENT_ADDRESS=

# Binance Web3 API (server-side only). With both set, /api/simulate uses the Binance Transaction API on BNB Chain
# and loans are cross-checked with the DeFi API; without them eth_call runs.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# RPC the wallet uses for the local fork chain (31337 only).
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545

# Public site URL for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
